{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "spanreed session-start"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "spanreed session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${SPANREED_SLEEPER:-}\" != 1 ] || spanreed sleeper _activity"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${SPANREED_SLEEPER:-}\" != 1 ] || spanreed sleeper _activity"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${SPANREED_SLEEPER:-}\" != 1 ] || spanreed sleeper _activity"
          }
        ]
      }
    ]
  }
}
